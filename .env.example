# Copy this file to `.env.local` and fill in the values. `.env.local` is ignored
# by git on purpose: NEVER commit real keys. Placeholders only in this file.

# --- Supabase (accounts, minutes, transcripts) -------------------------------
# Supabase dashboard -> Project Settings -> API. The project ref is
# xubbwgrjvvsbfvxcuzav. The anon key is a public identifier (it ships to every
# browser); never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://xubbwgrjvvsbfvxcuzav.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site --------------------------------------------------------------------
# Used for SEO/canonical links. Defaults to https://smallbird.in when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (payments; Razorpay dashboard -> Settings -> API Keys) ----------
# Only needed to test checkout. Use TEST-mode keys locally.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subscription plan ids (Razorpay dashboard -> Subscriptions -> Plans).
# The code reads exactly these two names (src/app/api/razorpay/create-subscription).
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_PRO_PLUS=
