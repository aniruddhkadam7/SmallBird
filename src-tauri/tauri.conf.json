{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smallbird",
  "version": "0.1.2",
  "identifier": "com.smallbird.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smallbird",
        "width": 760,
        "height": 720,
        "minWidth": 760,
        "minHeight": 720,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecars/rag-lite": "rag-lite"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QkQ0QjBBOURFQzk3QTIKUldTaWwreWRDa3U5R1hVZlROK1ZQTUp5WkoyL2xlTEVieTM2MnFtL21XMmJpWWpId3pvQktrQkMK",
      "endpoints": [
        "https://github.com/aniruddhkadam7/SmallBird/releases/latest/download/latest.json"
      ]
    }
  }
}
